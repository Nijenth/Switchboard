# Copy to .env and fill in six distinct, randomly generated local test passwords.
# These values are only for the disposable test database.
SWITCHBOARD_DB_BOOTSTRAP_PASSWORD=
SWITCHBOARD_DB_OWNER_PASSWORD=
SWITCHBOARD_CORE_PASSWORD=
SWITCHBOARD_CONFIG_LOADER_PASSWORD=
SWITCHBOARD_N8N_MOCK_PASSWORD=
SWITCHBOARD_REPORTING_PASSWORD=

# Future live gateway only. Keep empty for offline runs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SWITCHBOARD_OPENAI_MODEL=
SWITCHBOARD_ANTHROPIC_MODEL=

# Primary for /understand. The other provider is the fallback.
SWITCHBOARD_UNDERSTAND_PRIMARY=openai
SWITCHBOARD_DECIDE_CREDENTIALS=
SWITCHBOARD_RETRIEVE_CREDENTIALS=
SWITCHBOARD_DRAFT_CREDENTIALS=
SWITCHBOARD_LOOKUP_CREDENTIALS=
SWITCHBOARD_REFUND_CREDENTIALS=
SWITCHBOARD_APPROVAL_CREDENTIALS=
