#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

from pack_validation import PackError, read_catalog


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate or publish the Switchboard pack catalog")
    parser.add_argument("--check", action="store_true")
    parser.add_argument(
        "--packs-dir", type=Path, default=Path(__file__).resolve().parents[1] / "packs"
    )
    parser.add_argument("--knowledge-tenant", type=str)
    args = parser.parse_args()
    if args.check and args.knowledge_tenant:
        parser.error("--knowledge-tenant is only available during sync")
    try:
        registry, packs = read_catalog(args.packs_dir)
        print("Validated packs: " + ", ".join(p.config["key"] for p in packs))
        if not args.check:
            from pack_sync import sync

            sync(registry, packs, args.knowledge_tenant)
    except (PackError, OSError, ValueError, RecursionError) as error:
        print(f"Pack loader: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
