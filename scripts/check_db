#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
source scripts/db_common.sh
export SWITCHBOARD_MIGRATION_DATABASE=switchboard_test

listen_addresses=''
cluster_options=''
case "${1:-}" in
    '') ;;
    --core-integration)
        : "${SWITCHBOARD_CORE_TEST_MARKER:?Missing integration cluster marker}"
        if [[ ! $SWITCHBOARD_CORE_TEST_MARKER =~ ^[A-Fa-f0-9]{64}$ ]]; then
            printf 'Invalid integration cluster marker\n' >&2
            exit 1
        fi
        if [[ ! ${SWITCHBOARD_CORE_TEST_GATEWAY:-} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
            printf 'Invalid integration bridge gateway\n' >&2
            exit 1
        fi
        listen_addresses='*'
        cluster_options="-c switchboard.integration_marker=$SWITCHBOARD_CORE_TEST_MARKER"
        ;;
    *) printf 'Unknown database check mode\n' >&2; exit 1 ;;
esac

: "${SWITCHBOARD_DB_BOOTSTRAP_PASSWORD:?Missing bootstrap password}"
: "${SWITCHBOARD_DB_OWNER_PASSWORD:?Missing owner password}"
: "${SWITCHBOARD_CORE_PASSWORD:?Missing core password}"
: "${SWITCHBOARD_CONFIG_LOADER_PASSWORD:?Missing config loader password}"
: "${SWITCHBOARD_N8N_MOCK_PASSWORD:?Missing n8n mock password}"
: "${SWITCHBOARD_REPORTING_PASSWORD:?Missing reporting password}"

if [[ "$(id -un)" != postgres || "$(stat -f -c %T /var/lib/postgresql/data)" != tmpfs ]]; then
    printf 'Run this check as postgres on the disposable Compose tmpfs.\n' >&2
    exit 1
fi

# Each invocation owns a fresh cluster and socket. Never connect to a pre-existing server.
umask 077
check_dir=$(mktemp -d /var/lib/postgresql/data/check.XXXXXXXX)
export SWITCHBOARD_DB_SOCKET="$check_dir/socket"
data_dir="$check_dir/pgdata"
mkdir -- "$SWITCHBOARD_DB_SOCKET"

printf 'Initializing disposable PostgreSQL cluster\n'
initdb --pgdata="$data_dir" --username=switchboard_bootstrap --auth=scram-sha-256 \
    --pwfile=<(printf '%s\n' "$SWITCHBOARD_DB_BOOTSTRAP_PASSWORD") --encoding=UTF8 --no-locale >/dev/null

if [[ -n $listen_addresses ]]; then
    # The owner connection is used only to prepare time-sensitive integration fixtures.
    printf 'host switchboard_test switchboard_core,switchboard_config_loader,switchboard_owner,switchboard_n8n_mock %s/32 scram-sha-256\n' \
        "$SWITCHBOARD_CORE_TEST_GATEWAY" >> "$data_dir/pg_hba.conf"
fi

stop_db() {
    if [[ -f "$data_dir/postmaster.pid" ]]; then
        pg_ctl --pgdata="$data_dir" --mode=fast --wait stop >/dev/null
    fi
}
trap stop_db EXIT
trap 'exit 0' TERM INT
pg_ctl --pgdata="$data_dir" --log="$check_dir/postgres.log" --wait \
    --options="-c listen_addresses='$listen_addresses' -c unix_socket_directories=$SWITCHBOARD_DB_SOCKET -c unix_socket_permissions=0700 -p 5432 $cluster_options" \
    start

bash scripts/create_db_users
bash scripts/migrate
if [[ $(db_psql -qAt --command "SELECT to_regclass('public.demo_case_timeline') IS NULL") != t ]]; then
    printf 'Migrate-only database must not contain the demo timeline\n' >&2
    exit 1
fi
bash scripts/seed

if [[ -n $listen_addresses ]]; then
    db_psql --single-transaction --file=db/tests/check_fixtures.sql --file=db/tests/demo_case_timeline.sql
    if [[ $(db_psql_as switchboard_reporting "$SWITCHBOARD_REPORTING_PASSWORD" switchboard_test -qAt \
        --command "SELECT count(*) = 1 AND count(body_redacted) = 0 AND count(draft_body) = 0
          FROM public.demo_case_timeline
         WHERE case_id='92000000-0000-0000-0000-000000000001' AND event_kind='message'") != t ]]; then
        printf 'Reporting login cannot read the disposable demo timeline fixture\n' >&2
        exit 1
    fi
    printf 'Core integration database ready\n'
    sleep infinity &
    wait "$!"
    exit 0
fi

printf 'Running database safety checks\n'
db_psql --file=db/tests/safety_checks.sql
bash scripts/check_migrations
bash scripts/check_pack_sync

# Test fixtures must be visible to the independently authenticated sessions.
db_psql --single-transaction --file=db/tests/check_fixtures.sql
printf 'Running core login checks\n'
db_psql_as switchboard_core "$SWITCHBOARD_CORE_PASSWORD" switchboard_test --file=db/tests/core_checks.sql
printf 'Running mock login checks\n'
db_psql_as switchboard_n8n_mock "$SWITCHBOARD_N8N_MOCK_PASSWORD" switchboard_test --file=db/tests/n8n_mock_checks.sql
printf 'Running reporting login checks\n'
db_psql_as switchboard_reporting "$SWITCHBOARD_REPORTING_PASSWORD" switchboard_test --file=db/tests/reporting_checks.sql
