{
  "id": "SwitchboardLookups1",
  "name": "wf_lookups_run",
  "active": false,
  "nodes": [
    {
      "id": "SwitchboardLookups1-1",
      "name": "Receive lookup request",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "SwitchboardLookups1-config",
      "name": "Load service URLs",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        -150
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SwitchboardConfig1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "SwitchboardLookups1-1a",
      "name": "Request lookups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').first().json.core_base_url + '/lookups' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({case_id: $('Receive lookup request').first().json.case_id, message_id: $('Receive lookup request').first().json.message_id}) }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardLookupAuth",
          "name": "Switchboard Lookup"
        }
      }
    },
    {
      "id": "SwitchboardLookups1-1b",
      "name": "List pending lookups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Tool workflows run the pack's lookups; core decides which ones are pending.\nconst workflows = {order_identity_check: 'SwitchboardIdentity1', order_lookup: 'SwitchboardOrder1'};\nreturn ($input.first().json.pending ?? []).map(({action_id, tool_key}) => {\n  if (!workflows[tool_key]) throw new Error('No tool workflow for ' + tool_key);\n  return {json: {action_id, tool_key, workflow_id: workflows[tool_key]}};\n});"
      },
      "alwaysOutputData": true
    },
    {
      "id": "SwitchboardLookups1-1c",
      "name": "Any pending lookups",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "SwitchboardLookups1-1-pending",
              "leftValue": "={{ $json.action_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "SwitchboardLookups1-1d",
      "name": "Run lookup tool",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflow_id }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "SwitchboardLookups1-1e",
