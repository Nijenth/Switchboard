{
  "id": "SwitchboardReconcile1",
  "name": "wf_action_reconciler",
  "active": false,
  "nodes": [
    {
      "id": "SwitchboardReconcile1-1",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "SwitchboardReconcile1-2",
      "name": "List expired mock sends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Load service URLs').item.json.core_base_url + '/actions/reconciliation/pending' }}",
        "options": {
          "timeout": 5000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardReconcilerAuth",
          "name": "Switchboard Reconciler"
        }
      }
    },
    {
      "id": "SwitchboardReconcile1-3",
      "name": "Look up mock receipt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH receipt AS (\n  SELECT external_ref::text, NULL::jsonb AS output FROM demo.outbound_receipts\n   WHERE $4::text = 'send_reply' AND tenant_id=$1::uuid AND action_id=$2::uuid\n  UNION ALL\n  SELECT refund_reference::text, jsonb_build_object('refund_reference',refund_reference,'status','refunded')\n    FROM demo.order_refunds\n   WHERE $4::text = 'order_refund_issue' AND tenant_id=$1::uuid AND idempotency_key=$3::text\n)\nSELECT $2::uuid AS action_id, receipt.external_ref, receipt.output\n  FROM (SELECT 1) requested LEFT JOIN receipt ON true\n WHERE $4::text IN ('send_reply','order_refund_issue')",
        "options": {
          "queryReplacement": "={{ [$json.tenant_id, $json.action_id, $json.idempotency_key, $json.tool_key] }}"
        }
      }
    },
    {
      "id": "SwitchboardReconcile1-4",
      "name": "Submit lookup evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').first().json.core_base_url + '/actions/' + $json.action_id + '/reconcile' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.external_ref ? {outcome: 'found', lookup_ref: 'mock-receipt:' + $json.action_id, external_ref: $json.external_ref, ...($json.output ? {output: $json.output} : {})} : {outcome: 'absent', lookup_ref: 'mock-receipt:' + $json.action_id}) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardReconcilerAuth",
          "name": "Switchboard Reconciler"
        }
      }
    },
    {
      "id": "SwitchboardReconcile1-5",
      "name": "Check reconciliation response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap((item, index) => {\n  if (item.json.statusCode === 409) return [];\n  if (item.json.statusCode !== 200) throw new Error('Core reconciliation failed');\n  return [{json: {status: item.json.body.status}, pairedItem: {item: index}}];\n});"
      }
    },
    {
      "id": "SwitchboardReconcile1-config",
      "name": "Load service URLs",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        -150
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SwitchboardConfig1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Load service URLs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List expired mock sends": {
      "main": [
        [
          {
            "node": "Look up mock receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Look up mock receipt": {
      "main": [
        [
          {
            "node": "Submit lookup evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit lookup evidence": {
      "main": [
        [
          {
            "node": "Check reconciliation response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load service URLs": {
      "main": [
        [
          {
            "node": "List expired mock sends",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "errorWorkflow": "SwitchboardError1"
  },
  "pinData": {}
}
