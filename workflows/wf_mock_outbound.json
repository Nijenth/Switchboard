{
  "id": "SwitchboardDispatch1",
  "name": "wf_mock_outbound",
  "active": false,
  "nodes": [
    {
      "id": "SwitchboardDispatch1-1",
      "name": "Every ten seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "SwitchboardDispatch1-2",
      "name": "List approved mock sends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SWITCHBOARD_CORE_URL + '/actions/dispatch/send-reply' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SWITCHBOARD_WORKER_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 5000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      }
    },
    {
      "id": "SwitchboardDispatch1-3",
      "name": "Run mock send",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SwitchboardSend1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Every ten seconds": {
      "main": [
        [
          {
            "node": "List approved mock sends",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List approved mock sends": {
      "main": [
        [
          {
            "node": "Run mock send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "errorWorkflow": "SwitchboardError1"
  },
  "pinData": {}
}
