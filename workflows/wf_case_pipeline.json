{
  "id": "SwitchboardCase1",
  "name": "wf_case_pipeline",
  "active": false,
  "nodes": [
    {
      "id": "SwitchboardCase1-1",
      "name": "Receive normalized email",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "SwitchboardCase1-2",
      "name": "Prepare canonical ingress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const { randomUUID } = require('crypto');\nreturn $input.all().map(({json: m}) => ({json:{...m, trace_id:randomUUID(), channel:'email'}}));"
      }
    },
    {
      "id": "SwitchboardCase1-3",
      "name": "Ingest email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').item.json.core_base_url + '/ingest' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Prepare canonical ingress').item.json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardIngressAuth",
          "name": "Switchboard Ingress"
        }
      }
    },
    {
      "id": "SwitchboardCase1-4",
      "name": "Understand message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').item.json.core_base_url + '/understand' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').item.json.case_id,message_id:$('Ingest email').item.json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardUnderstandAuth",
          "name": "Switchboard Understand"
        }
      }
    },
    {
      "id": "SwitchboardCase1-5",
      "name": "Retrieve knowledge",
      "type": "n8n-nodes-base.httpRequest",
