          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').item.json.case_id,message_id:$('Ingest email').item.json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardRetrieveAuth",
          "name": "Switchboard Retrieve"
        }
      }
    },
    {
      "id": "SwitchboardCase1-6",
