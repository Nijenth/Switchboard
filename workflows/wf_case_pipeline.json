              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').item.json.case_id,message_id:$('Ingest email').item.json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardDraftAuth",
          "name": "Switchboard Draft"
        }
      }
    },
    {
      "id": "SwitchboardCase1-7",
      "name": "Decide and queue reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
