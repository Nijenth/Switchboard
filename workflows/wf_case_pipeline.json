        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').first().json.case_id,message_id:$('Ingest email').first().json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardRetrieveAuth",
          "name": "Switchboard Retrieve"
        }
      }
    },
    {
      "id": "SwitchboardCase1-6",
      "name": "Draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').first().json.core_base_url + '/drafts' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').first().json.case_id,message_id:$('Ingest email').first().json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardDraftAuth",
          "name": "Switchboard Draft"
        }
      }
    },
    {
      "id": "SwitchboardCase1-7",
      "name": "Decide and queue reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load service URLs').first().json.core_base_url + '/decide' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({...({case_id:$('Ingest email').first().json.case_id,message_id:$('Ingest email').first().json.message_id}),queue_reply:true})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardDecideAuth",
          "name": "Switchboard Decide"
        }
      }
    },
    {
      "id": "SwitchboardCase1-config",
      "name": "Load service URLs",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        360,
        -150
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "SwitchboardConfig1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "SwitchboardCase1-lookup-request",
      "name": "Prepare lookup request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const ingested = $('Ingest email').first().json;\nreturn [{json: {case_id: ingested.case_id, message_id: ingested.message_id}}];"
      }
    },
    {
      "id": "SwitchboardCase1-lookups",
      "name": "Run lookups",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
