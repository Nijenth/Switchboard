{
  "id": "SwitchboardCase1",
  "name": "wf_case_pipeline",
  "active": false,
  "nodes": [
    {
      "id": "SwitchboardCase1-1",
      "name": "Receive normalized email",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "SwitchboardCase1-2",
      "name": "Prepare canonical ingress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json: m}) => {\n  const trace = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n    const r = Math.floor(Math.random() * 16);\n    return (c === 'x' ? r : ((r & 3) | 8)).toString(16);\n  });\n  return {json:{...m, trace_id:trace, channel:'email'}};\n});"
      }
    },
    {
      "id": "SwitchboardCase1-3",
      "name": "Ingest email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardIngressAuth",
          "name": "Switchboard Ingress"
        }
      }
    },
    {
      "id": "SwitchboardCase1-4",
      "name": "Understand message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/understand",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(({case_id:$('Ingest email').item.json.case_id,message_id:$('Ingest email').item.json.message_id})) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SwitchboardUnderstandAuth",
          "name": "Switchboard Understand"
        }
      }
    },
    {
      "id": "SwitchboardCase1-5",
